{
	"name": "@orgsdk/plugin-zendesk",
	"version": "0.1.2",
	"description": "Read-only Zendesk evidence for ecommerce exceptions.",
	"type": "module",
	"private": true,
	"license": "Apache-2.0",
	"scripts": {
		"check": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"validate": "orgsdk-plugin validate",
		"package": "TAR_OPTIONS='--mtime=@0 --owner=0 --group=0 --numeric-owner --mode=0644' orgsdk-plugin package",
		"version-guard": "orgsdk-plugin version-guard",
		"build": "bun run typecheck && bun run validate && bun run package",
		"build:npm": "node scripts/build-npm.mjs",
		"test:executor": "node scripts/test-executor.mjs",
		"pack:npm": "npm pack ./dist/npm --ignore-scripts",
		"test:registration": "node scripts/test-registration.mjs"
	},
	"dependencies": {
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@orgsdk/plugins": "0.2.2",
		"@types/bun": "^1.3.9",
		"typescript": "~6.0.3",
		"@orgsdk/executor": "0.1.0"
	},
	"patchedDependencies": {
		"@orgsdk/executor@0.1.0": "patches/@orgsdk%2Fexecutor@0.1.0.patch"
	},
	"author": "OrgSDK",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OrgSDK/orgsdk-plugin-zendesk.git"
	},
	"bugs": {
		"url": "https://github.com/OrgSDK/orgsdk-plugin-zendesk/issues"
	},
	"homepage": "https://github.com/OrgSDK/orgsdk-plugin-zendesk#readme",
	"overrides": {
		"zod": "4.6.7"
	}
}
